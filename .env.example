# Public site URL used for canonical links, the sitemap, and the RSS feed.
NEXT_PUBLIC_SITE_URL=https://davelims.vercel.app

# Optional. The Book a call button uses https://calendly.com/davelima2/30min when this is unset.
NEXT_PUBLIC_CALENDLY_URL=

# Supabase project. Use the publishable key only — never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only token for the GitHub activity counts. GraphQL requires one.
# Create a fine-grained personal access token with no extra permissions
# (public read only). Do not commit the token, and do not prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=
